# Postgres connection string. For Supabase use the *pooler* URL from
# Dashboard -> Connect (Transaction pooler, port 6543); GitHub runners have no IPv6.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# MiniMax (OpenAI-compatible API). Use https://api.minimaxi.com/v1 for mainland-China keys.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# Web app login password (Vercel env var).
APP_PASSWORD=
